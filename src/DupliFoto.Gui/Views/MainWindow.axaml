<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DupliFoto.Gui.ViewModels"
        xmlns:l="using:DupliFoto.Gui.Views"
        x:Class="DupliFoto.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DupliFoto"
        Icon="avares://DupliFoto/Assets/DupliFoto.ico"
        Width="1360" Height="900" MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TransparencyLevelHint="Mica"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Misure normali. Stanno qui e non sui controlli, così la disposizione compatta le può cambiare. -->
    <Style Selector="Grid#MainLayout">
      <Setter Property="Margin" Value="16,12,16,16" />
    </Style>
    <Style Selector="Border#TopCard">
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="StackPanel.top">
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="TextBlock.chip">
      <Setter Property="MaxWidth" Value="460" />
    </Style>
    <Style Selector="Border.options">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <!-- «Aggiungi cartella»: grigio e discreto come le cartelle accanto, della stessa altezza -->
    <Style Selector="Button.add-folder">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border#Stage">
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Grid.photo">
      <Setter Property="Margin" Value="20,14,20,10" />
    </Style>
    <Style Selector="Panel.photo-area">
      <Setter Property="Margin" Value="0,10" />
    </Style>
    <Style Selector="TextBlock.details">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="40" />
    </Style>
    <Style Selector="Border#DecisionBar">
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Fill" Value="{DynamicResource DotOffBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.ready">
      <Setter Property="Fill" Value="{DynamicResource DotReadyBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.active">
      <Setter Property="Fill" Value="{DynamicResource DotOnBrush}" />
    </Style>

    <!-- Disposizione compatta per gli schermi bassi (1366×768, o con il ridimensionamento al 125%):
         la attiva MainWindow quando l'altezza utile scende sotto i 860 punti, e lì l'elenco in basso è più basso. -->
    <Style Selector="Grid#MainLayout.compact">
      <Setter Property="Margin" Value="12,8,12,8" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Border#TopCard">
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Grid#MainLayout.compact StackPanel.top">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Grid#MainLayout.compact TextBlock.chip">
      <Setter Property="MaxWidth" Value="300" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Border.options">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="0,5,0,0" />
    </Style>
    <Style Selector="Grid#MainLayout.compact TextBlock.hint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Border#Stage">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Grid.photo">
      <Setter Property="Margin" Value="14,8,14,4" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Panel.photo-area">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Grid#MainLayout.compact TextBlock.details">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Grid#MainLayout.compact TextBlock.big">
      <Setter Property="FontSize" Value="30" />
    </Style>
    <Style Selector="Grid#MainLayout.compact Border#DecisionBar">
      <Setter Property="Padding" Value="12,5" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- Le voci dei menu a tendina: l'etichetta nella lingua in uso, che cambia insieme alla lingua -->
    <DataTemplate DataType="vm:IChoice">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
    <!-- Metà del confronto: etichetta, foto, informazioni, azioni -->
    <DataTemplate DataType="vm:PhotoPanel">
      <Grid RowDefinitions="Auto,*,Auto" Classes="photo">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14"
                    Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsKeeper}" />
          <TextBlock Text="{Binding Role}" Classes="h" />
          <TextBlock Text="{Binding RootName, StringFormat='· {0}'}" Classes="muted" VerticalAlignment="Center"
                     IsVisible="{Binding RootName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="{l:T RootTip}" />
        </StackPanel>

        <Panel Grid.Row="1" Classes="photo-area">
          <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource PhotoBackBrush}"
                  BoxShadow="0 2 12 0 #24000000"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{Binding Image}" Stretch="Uniform" />
          </Border>
          <ProgressBar IsIndeterminate="True" Width="140" IsVisible="{Binding IsLoading}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Placeholder}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding ShowPlaceholder}" />
        </Panel>

        <StackPanel Grid.Row="2" Spacing="1" HorizontalAlignment="Center" MaxWidth="600">
          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
            <Button Classes="subtle icon" Command="{Binding OpenCommand}" IsEnabled="{Binding HasPhoto}"
                    ToolTip.Tip="{l:T OpenInViewer}" AutomationProperties.Name="{l:T OpenPhoto}">
              <PathIcon Data="{StaticResource IconEye}" />
            </Button>
            <Button Classes="subtle icon" Command="{Binding RevealCommand}" IsEnabled="{Binding HasPhoto}"
                    ToolTip.Tip="{l:T ShowInFolder}" AutomationProperties.Name="{l:T ShowInFolder}">
              <PathIcon Data="{StaticResource IconFolderOpen}" />
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding Folder}" Classes="muted small" TextAlignment="Center" TextTrimming="PrefixCharacterEllipsis"
                     ToolTip.Tip="{Binding Folder}" />
          <TextBlock Text="{Binding Details}" Classes="faint small details" TextAlignment="Center" ToolTip.Tip="{Binding Details}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- Il confronto e l'elenco si dividono l'altezza; se nemmeno la disposizione compatta ci sta, la finestra scorre
         (l'altezza di MainLayout la imposta MainWindow) invece di mettere una parte sopra l'altra. -->
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="MainLayout">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="280" />
        <RowDefinition Height="6" />
        <RowDefinition Height="230" MinHeight="150" />
      </Grid.RowDefinitions>

      <!-- ============ In alto: cartelle, modalità, avvio ============ -->
      <Border Grid.Row="0" x:Name="TopCard" Classes="card">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

          <StackPanel Classes="top">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{l:T FoldersToScan}" Classes="h" VerticalAlignment="Center" />
              <TextBlock Text="{l:T DragHint}" Classes="faint small" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Le cartelle, e subito dopo, discreto, il pulsante per aggiungerne -->
            <WrapPanel>
            <ItemsControl ItemsSource="{Binding Folders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderItem">
                  <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource CardStrokeBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="10,2,3,2" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Text="{Binding Path}" Classes="chip" VerticalAlignment="Center" Margin="4,0"
                                 TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                      <Button Classes="subtle icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T RemoveFromList}"
                              AutomationProperties.Name="{l:T RemoveFolderFromList}">
                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T NoFolders}" Classes="muted" IsVisible="{Binding !HasFolders}" VerticalAlignment="Center" Margin="0,0,12,8" />
            <Button x:Name="AddFolderButton" Classes="add-folder" Click="OnAddFolder" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconFolderAdd}" Width="14" Height="14" />
                <TextBlock Text="{l:T AddFolder}" />
              </StackPanel>
            </Button>
            </WrapPanel>

            <!-- Con due o più cartelle: quale copia tenere, e se confrontare anche dentro la stessa cartella.
                 Sulla stessa riga quando c'è posto. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasSeveralFolders}" IsEnabled="{Binding IsIdle}">
            <WrapPanel>
              <WrapPanel Margin="0,0,26,0">
                <TextBlock Text="{l:T CopyToKeep}" Classes="label" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip.Tip="{Binding KeepHint}" />
                <RadioButton GroupName="keep" Content="{l:T AutomaticChoice}" IsChecked="{Binding KeepAutomatic}" Margin="0,0,18,0"
                             ToolTip.Tip="{l:T AutomaticChoiceTip}" />
                <ItemsControl ItemsSource="{Binding Folders}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderItem">
                      <RadioButton GroupName="keep" Content="{Binding Name}" IsChecked="{Binding IsKept}" Margin="0,0,18,0"
                                   ToolTip.Tip="{Binding KeepTip}" AutomationProperties.Name="{Binding KeepName}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
              <WrapPanel>
                <TextBlock Text="{l:T LookFor}" Classes="label" VerticalAlignment="Center" Margin="0,0,14,0" />
                <RadioButton GroupName="compare" Content="{l:T InAllPhotos}" IsChecked="{Binding CompareEverywhere}" Margin="0,0,18,0"
                             ToolTip.Tip="{l:T InAllPhotosTip}" />
                <RadioButton GroupName="compare" Content="{l:T AcrossFolders}" IsChecked="{Binding CrossFolderOnly}"
                             ToolTip.Tip="{l:T AcrossFoldersTip}" />
              </WrapPanel>
            </WrapPanel>
            <TextBlock Text="{Binding KeepHint}" Classes="faint small hint" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <!-- Modalità e avvio -->
          <StackPanel Grid.Column="1" Spacing="6" Margin="24,0,0,0" Width="300">
            <TextBlock Text="{l:T Mode}" Classes="label" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding IsIdle}" />
            <TextBlock Text="{Binding SelectedMode.Description}" Classes="muted small" TextWrapping="Wrap" MinHeight="32" />
          </StackPanel>

          <!-- Seconda riga: opzioni rapide -->
          <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                  Classes="options">
            <Grid ColumnDefinitions="*,Auto">
              <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,0">
                  <TextBlock Text="{l:T DuplicatesGoTo}" Classes="label" />
                  <ComboBox ItemsSource="{Binding Disposals}" SelectedItem="{Binding SelectedDisposal}" Width="150"
                            IsEnabled="{Binding CanChangeDisposal}" ToolTip.Tip="{Binding SelectedDisposal.Description}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,0" IsVisible="{Binding IsAutomaticMode}">
                  <TextBlock Text="{l:T AutoFrom}" Classes="label" />
                  <NumericUpDown Value="{Binding Threshold}" Minimum="90" Maximum="100" Increment="1" FormatString="0"
                                 Width="120" IsEnabled="{Binding IsIdle}" />
                  <TextBlock Text="{l:T PercentUp}" Classes="label" />
                </StackPanel>
                <CheckBox IsChecked="{Binding IncludeSubfolders}" Content="{l:T Subfolders}" Margin="0,0,20,0" IsEnabled="{Binding IsIdle}" />
                <CheckBox IsChecked="{Binding DetectBursts}" Content="{l:T LookForBursts}" Margin="0,0,20,0" IsEnabled="{Binding IsIdle}" />
                <Button Classes="subtle" IsEnabled="{Binding IsIdle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconTune}" />
                    <TextBlock Text="{l:T MoreOptions}" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Width="400" Spacing="8" Margin="4">
                        <TextBlock Text="{l:T Language}" Classes="h" />
                        <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="240" />

                        <TextBlock Text="{l:T QuarantineFolder}" Classes="h" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Text="{Binding QuarantineRoot}" IsEnabled="{Binding CanChangeDisposal}" />
                          <Button Grid.Column="1" Content="{l:T Browse}" Margin="8,0,0,0" Click="OnBrowseQuarantine"
                                  IsEnabled="{Binding CanChangeDisposal}" />
                        </Grid>
                        <TextBlock Text="{l:T QuarantineHint}" Classes="muted small" />

                        <TextBlock Text="{l:T BurstShots}" Classes="h" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{l:T AtMost}" Classes="label" />
                          <NumericUpDown Value="{Binding BurstSeconds}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="120" />
                          <TextBlock Text="{l:T SecondsBetween}" Classes="label" />
                        </StackPanel>

                        <TextBlock Text="{l:T NeuralOptional}" Classes="h" Margin="0,8,0,0" />
                        <TextBlock Text="{l:T NeuralHint}"
                                   Classes="muted small" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Text="{Binding ModelPath}" PlaceholderText="{l:T NoModel}" />
                          <Button Grid.Column="1" Content="{l:T Browse}" Margin="8,0,0,0" Click="OnBrowseModel" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{l:T RunOn}" Classes="label" />
                          <ComboBox ItemsSource="{Binding Accelerators}" SelectedItem="{Binding SelectedAccelerator}" Width="220" />
                        </StackPanel>
                        <TextBlock Text="{l:T WindowsOnly}" Classes="faint small"
                                   IsVisible="{Binding !IsNeuralAvailable}" />

                        <TextBlock Text="{l:T DupliFotoFiles}" Classes="h" Margin="0,8,0,0" />
                        <TextBlock Text="{l:T DataFolderHint}"
                                   Classes="muted small" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                          <Button Grid.Column="1" Content="{l:T Open}" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                        <TextBlock Text="{l:T DataFolderFallback}"
                                   Classes="faint small" TextWrapping="Wrap" IsVisible="{Binding !DataFolderIsNextToExe}" />
                        <CheckBox IsChecked="{Binding RemoveTempOnExit}">
                          <TextBlock Text="{l:T RemoveTemp}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{l:T RemoveTempHint}"
                                   Classes="faint small" TextWrapping="Wrap" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </WrapPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="accent" Command="{Binding StartCommand}" IsVisible="{Binding !IsScanning}"
                        IsEnabled="{Binding CanStart}" Padding="18,8" MinWidth="180">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconPlay}" />
                    <TextBlock Text="{l:T StartSearch}" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsScanning}" Padding="18,8" MinWidth="180">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconStop}" />
                    <TextBlock Text="{l:T Stop}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ============ Al centro: il confronto ============ -->
      <Border Grid.Row="1" x:Name="Stage" Classes="card" Background="{DynamicResource StageBrush}" ClipToBounds="True">
        <Panel>
          <!-- Benvenuto -->
          <StackPanel IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
            <PathIcon Data="{StaticResource IconImages}" Width="44" Height="44" Foreground="{DynamicResource FaintBrush}" />
            <TextBlock Text="{l:T WelcomeTitle}" Classes="title" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{l:T WelcomeText}" />
            <TextBlock Text="{Binding VersionText}" Classes="faint small" HorizontalAlignment="Center" Margin="0,6,0,0" />
          </StackPanel>

          <!-- Ricerca in corso -->
          <StackPanel IsVisible="{Binding IsScanning}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="420">
            <TextBlock Text="{l:T Searching}" Classes="title" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Nessun doppione -->
          <StackPanel IsVisible="{Binding ShowNoDuplicates}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
            <PathIcon Data="{StaticResource IconCheck}" Width="40" Height="40" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Text="{l:T NoDuplicates}" Classes="title" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock IsVisible="{Binding ShowPickHint}" Text="{l:T PickPair}"
                     Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- Confronto affiancato -->
          <Grid IsVisible="{Binding ShowComparison}" RowDefinitions="*,Auto" ColumnDefinitions="*,190,*">
            <ContentControl Grid.Column="0" Content="{Binding Left}" />

            <!-- Con poco spazio si rimpicciolisce, invece di finire sopra i pulsanti -->
            <Viewbox Grid.Column="1" x:Name="MiddleColumn" StretchDirection="DownOnly" Stretch="Uniform" VerticalAlignment="Center">
            <StackPanel Width="190" Spacing="4">
              <TextBlock Text="{l:T Confidence}" Classes="muted small" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Classes="conf big" Classes.ok="{Binding IsHigh}" Classes.mid="{Binding IsMid}" Classes.low="{Binding IsLow}" />
              <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ReasonText}" Classes="muted small" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KeeperReasonText}" Classes="faint small" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                         IsVisible="{Binding KeeperReasonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button x:Name="SwapButton" Classes="subtle" HorizontalAlignment="Center" Margin="0,10,0,0" Command="{Binding SwapCommand}"
                      IsEnabled="{Binding CanSwap}" ToolTip.Tip="{l:T SwapTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconSwap}" />
                  <TextBlock Text="{l:T Swap}" />
                </StackPanel>
              </Button>
            </StackPanel>
            </Viewbox>

            <ContentControl Grid.Column="2" Content="{Binding Right}" />

            <!-- Barra delle decisioni -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" x:Name="DecisionBar" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="subtle icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanNavigate}" ToolTip.Tip="{l:T PreviousPair}"
                          AutomationProperties.Name="{l:T PreviousPair}">
                    <PathIcon Data="{StaticResource IconChevronLeft}" />
                  </Button>
                  <Button Classes="subtle icon" Command="{Binding NextCommand}" IsEnabled="{Binding CanNavigate}" ToolTip.Tip="{l:T NextPair}"
                          AutomationProperties.Name="{l:T NextPair}">
                    <PathIcon Data="{StaticResource IconChevronRight}" />
                  </Button>
                  <TextBlock Text="{Binding DecisionHint}" Classes="muted small" VerticalAlignment="Center" Margin="8,0,0,0"
                             TextWrapping="Wrap" MaxWidth="240" />
                </StackPanel>

                <StackPanel Grid.Column="1" x:Name="PairActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            Margin="12,0" IsVisible="{Binding !IsReadOnlyMode}">
                  <Button Classes="accent" Command="{Binding MoveDuplicateCommand}" IsEnabled="{Binding CanDecide}" Padding="16,7"
                          ToolTip.Tip="{Binding MoveTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconMove}" />
                      <TextBlock Text="{l:T MoveRight}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding KeepBothCommand}" IsEnabled="{Binding CanDecide}" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconCheck}" />
                      <TextBlock Text="{l:T KeepBoth}" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" x:Name="BulkActions" Orientation="Horizontal" VerticalAlignment="Center"
                            IsVisible="{Binding !IsReadOnlyMode}">
                  <Button Classes="subtle" Command="{Binding ApplyToAllOfKindCommand}" IsEnabled="{Binding CanDecide}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconCheckAll}" />
                      <TextBlock Text="{Binding ApplyAllText}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Panel>
      </Border>

      <GridSplitter Grid.Row="2" Background="Transparent" ResizeDirection="Rows" />

      <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <!-- ============ Contatori ============ -->
      <Grid x:Name="Counters" ColumnDefinitions="Auto,*,Auto" Margin="4,2,4,4">
        <StackPanel Orientation="Horizontal" Spacing="22">
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding FilesCount, StringFormat='{}{0:N0}'}" />
            <TextBlock Classes="name" Text="{l:T PhotosAnalysed}" />
          </StackPanel>
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding GroupsCount, StringFormat='{}{0:N0}'}" />
            <TextBlock Classes="name" Text="{l:T Groups}" />
          </StackPanel>
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding DuplicatesCount, StringFormat='{}{0:N0}'}" />
            <TextBlock Classes="name" Text="{l:T Duplicates}" />
          </StackPanel>
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding ReclaimableText}" />
            <TextBlock Classes="name" Text="{l:T Reclaimable}" />
          </StackPanel>
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding PendingCount, StringFormat='{}{0:N0}'}" />
            <TextBlock Classes="name" Text="{l:T ToDecide}" />
          </StackPanel>
          <StackPanel Classes="stat" Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="value" Text="{Binding MovedCount, StringFormat='{}{0:N0}'}" />
            <TextBlock Classes="name" Text="{l:T Moved}" />
            <TextBlock Classes="name" Text="{Binding MovedBytesText, StringFormat='({0})'}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted small" HorizontalAlignment="Right"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="24,0,0,0" IsVisible="{Binding !IsScanning}" />

        <!-- I motori: verde dove si lavora, giallo dove si potrebbe, rosso dove no. I dettagli nel suggerimento. -->
        <ItemsControl Grid.Column="2" x:Name="EngineDots" ItemsSource="{Binding Engines}" Margin="18,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.Name="{l:T Engines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EngineDot">
              <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent" ToolTip.Tip="{Binding Tip}"
                          AutomationProperties.Name="{Binding Tip}">
                <Ellipse Width="9" Height="9" Classes="dot" VerticalAlignment="Center"
                         Classes.off="{Binding IsOff}" Classes.ready="{Binding IsReady}" Classes.active="{Binding IsActive}" />
                <TextBlock Text="{Binding Name}" Classes="muted small" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- ============ In basso: elenco delle coppie, con le azioni che valgono per tutto l'elenco ============ -->
      <Border Grid.Row="1" x:Name="PairList" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,6,12,4">
            <TextBlock Text="{l:T PairsFound}" Classes="h" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0" VerticalAlignment="Center">
              <Button Classes="subtle" Command="{Binding ApplyAutomaticCommand}" IsVisible="{Binding CanApplyAutomatic}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconCheckAll}" />
                  <TextBlock Text="{Binding AutomaticText}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                      ToolTip.Tip="{l:T UndoTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconUndo}" />
                  <TextBlock Text="{l:T UndoMoves}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding ExportReportCommand}" IsEnabled="{Binding HasResults}"
                      ToolTip.Tip="{l:T ReportTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconReport}" />
                  <TextBlock Text="{l:T Report}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{l:T Show}" Classes="label" />
              <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="180" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="120,*,*,140,90" Margin="16,0,16,4">
            <TextBlock Text="{l:T Status}" Classes="faint small" />
            <TextBlock Grid.Column="1" Text="{l:T ToKeep}" Classes="faint small" />
            <TextBlock Grid.Column="2" Text="{l:T ToMove}" Classes="faint small" />
            <TextBlock Grid.Column="3" Text="{l:T Kind}" Classes="faint small" />
            <TextBlock Grid.Column="4" Text="{l:T Confidence}" Classes="faint small" HorizontalAlignment="Right" />
          </Grid>

          <TextBlock Grid.Row="2" Text="{Binding ListEmptyText}" Classes="muted" IsVisible="{Binding ShowListEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
          <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding VisiblePairs}" SelectedItem="{Binding SelectedPair}"
                   Background="Transparent" Margin="0,0,0,4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PairItem">
                <Grid ColumnDefinitions="120,*,*,140,90">
                  <TextBlock Text="{Binding StatusText}" Classes="status small" VerticalAlignment="Center"
                             Classes.pending="{Binding IsPending}" Classes.moved="{Binding IsMoved}" Classes.blocked="{Binding IsBlocked}"
                             ToolTip.Tip="{Binding Note}" />
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,12,0">
                    <TextBlock Text="{Binding KeeperName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding KeeperFolder}" Classes="faint small" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
                  </Grid>
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="0,0,12,0">
                    <TextBlock Text="{Binding DuplicateName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding DuplicateFolder}" Classes="faint small" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Classes="muted" />
                  <TextBlock Grid.Column="4" Text="{Binding ConfidenceText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                             Classes="conf" Classes.ok="{Binding IsHigh}" Classes.mid="{Binding IsMid}" Classes.low="{Binding IsLow}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      </Grid>
    </Grid>
    </ScrollViewer>

    <!-- ============ Domanda di conferma ============ -->
    <Border Background="{DynamicResource OverlayBrush}" IsVisible="{Binding ConfirmVisible}">
      <Border Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
              CornerRadius="8" Padding="24,20" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 8 32 0 #40000000">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding ConfirmTitle}" Classes="title" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" LineHeight="21" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Command="{Binding ConfirmNoCommand}" Content="{l:T Cancel}" MinWidth="110" />
            <Button Classes="accent" Command="{Binding ConfirmYesCommand}" MinWidth="110">
              <TextBlock Text="{Binding ConfirmYesText}" FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
